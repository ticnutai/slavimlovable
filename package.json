{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "cross-env VITE_BYPASS_AUTH=true vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint src",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:folders": "playwright test tests/folder-management.spec.ts",
    "test:health": "cross-env NO_WEB_SERVER=1 playwright test tests/health.spec.ts --project=chromium",
    "test:routes": "cross-env NO_WEB_SERVER=1 playwright test tests/routes.spec.ts --project=chromium",
    "test:react": "cross-env NO_WEB_SERVER=1 playwright test tests/react-integrity.spec.ts --project=chromium",
    "debug:app": "node debug-app.js",
    "debug:full": "node debug-app.js && npm run test",
    "db:check": "node scripts/check-db.js",
    "db:seed": "node populate-data.js",
    "db:seed-sample": "node diagnostics/seed-sample-data.js",
    "db:view": "start diagnostics/view-data.html",
    "diagnose": "node diagnostics/run-diagnosis.js",
    "diagnose:supabase": "node diagnostics/test-supabase-connection.js",
    "diagnose:html": "node diagnostics/generate-html-test.js",
  "data:fix-orphans": "node scripts/fix-orphan-tasks.js",
    "git:auto": "node scripts/auto-commit.js",
    "git:commit": "pwsh -File scripts/auto-commit.ps1",
    "clean": "node scripts/cleanup.js",
    "clean:full": "pwsh -File scripts/cleanup.ps1",
    "clean:deep": "pwsh -File scripts/cleanup-deep.ps1",
    "q:dup": "jscpd --min-lines 5 --reporters console --silent --threshold 0 src",
    "q:unused": "knip",
    "q:cycles": "madge --circular --extensions ts,tsx,js,jsx src",
    "q:deps": "depcruise --include-only '^src\\/' --output-type text src"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.75.0",
    "@tanstack/react-query": "^5.83.0",
    "@types/papaparse": "^5.3.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "input-otp": "^1.4.2",
    "localforage": "^1.10.0",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/experimental-ct-react": "^1.56.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "^16.10.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jscpd": "^4.0.5",
    "knip": "^5.65.0",
    "lovable-tagger": "^1.1.11",
    "madge": "^8.0.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.1.10"
  }
}
